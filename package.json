{
  "name": "kairos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:rust": "cargo check --workspace",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:rust": "cargo fmt --all",
    "format:rust:check": "cargo fmt --all --check",
    "test": "vitest run",
    "bench": "cargo bench",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:rust": "cargo llvm-cov -p kairos-core --lib --summary-only --fail-under-lines 98",
    "test:rust": "cargo test --workspace",
    "knip": "knip",
    "verify": "bun run typecheck && bun run typecheck:rust && bun run lint && bun run lint:rust && bun run format:check && bun run format:rust:check && bun run test && bun run test:rust && bun run knip"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "knip": "^5",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^7",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "katex": "^0.18.7",
    "vue": "^3.5.42"
  }
}
